# Copy to config.env and fill in real values:
#   cp config.env.example config.env

# Display name shown on the web page / API responses
DEVICE_NAME=Mac mini

# Mac mini Ethernet (preferred) or Wi-Fi MAC address
# Example formats: AA:BB:CC:DD:EE:FF  or  AA-BB-CC-DD-EE-FF
MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# Use your LAN directed broadcast when possible, e.g. 192.168.1.255
# 255.255.255.255 works when the container uses host networking
BROADCAST_ADDRESS=255.255.255.255

# Standard Wake-on-LAN UDP port
WOL_PORT=9

# Send multiple packets in case the first is dropped
PACKET_COUNT=3

# HTTP service
HTTP_HOST=0.0.0.0
HTTP_PORT=8787

# Required bearer token for /wake (change this!)
# Generate one: openssl rand -hex 24
WAKE_TOKEN=change-me-to-a-long-random-string
